<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/metal"
    tools:context=".gamesActivities.MasterMindActivity">

    <!-- ══ CLAVIER — même style que StandardGameActivity ══ -->
    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <GridLayout
            android:id="@+id/gridLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="9"
            android:rowCount="3"/>
    </LinearLayout>

    <!-- ══ CONTENU au-dessus du clavier ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomLayout"
        android:orientation="vertical">

        <!-- BANDEAU TITRE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120px"
            android:orientation="horizontal"
            android:background="@drawable/customborderbuttons"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Master Mind"
                android:textColor="#08FF00"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/neon"
                android:gravity="center"
                android:shadowColor="#08FF00"
                android:shadowDx="4" android:shadowDy="4" android:shadowRadius="10"/>

            <TextView
                android:id="@+id/nb_tours"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Tour 1 / 20"
                android:textColor="#FFF200"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/led"
                android:gravity="center"
                android:shadowColor="#FF8C00"
                android:shadowDx="4" android:shadowDy="4" android:shadowRadius="10"/>

            <TextView
                android:id="@+id/tv_joueur_courant"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Joueur"
                android:textColor="#00FFEA"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/neon"
                android:gravity="center"
                android:shadowColor="#00FFEA"
                android:shadowDx="4" android:shadowDy="4" android:shadowRadius="10"/>
        </LinearLayout>

        <!-- COMBINAISON SECRÈTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="4dp"
            android:background="#22FFFFFF"
            android:padding="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Combinaison :"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:fontFamily="@font/bines"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"/>

            <!-- Case 1 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/combi_un"
                    android:layout_width="58dp" android:layout_height="58dp"
                    android:text="?" android:textSize="24sp" android:textStyle="bold"
                    android:gravity="center" android:fontFamily="@font/led"
                    android:background="@drawable/custombordermm"
                    android:textColor="#888888"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="①" android:textColor="#555555" android:textSize="11sp"/>
            </LinearLayout>

            <!-- Case 2 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/combi_deux"
                    android:layout_width="58dp" android:layout_height="58dp"
                    android:text="?" android:textSize="24sp" android:textStyle="bold"
                    android:gravity="center" android:fontFamily="@font/led"
                    android:background="@drawable/custombordermm"
                    android:textColor="#888888"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="②" android:textColor="#555555" android:textSize="11sp"/>
            </LinearLayout>

            <!-- Case 3 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/combi_trois"
                    android:layout_width="58dp" android:layout_height="58dp"
                    android:text="?" android:textSize="24sp" android:textStyle="bold"
                    android:gravity="center" android:fontFamily="@font/led"
                    android:background="@drawable/custombordermm"
                    android:textColor="#888888"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="③" android:textColor="#555555" android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- FLÉCHETTES DU TOUR EN COURS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="4dp"
            android:background="#1AFFFFFF"
            android:padding="6dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tirs :" android:textColor="#AAAAAA" android:textSize="14sp"
                android:fontFamily="@font/bines" android:paddingStart="8dp" android:paddingEnd="12dp"/>

            <!-- Fléchette 1 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/tir_un"
                    android:layout_width="58dp" android:layout_height="58dp"
                    android:text="·" android:textSize="26sp" android:textStyle="bold"
                    android:gravity="center" android:fontFamily="@font/led"
                    android:textColor="#444444"/>
                <ImageView android:id="@+id/ind_un"
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:visibility="invisible"/>
            </LinearLayout>

            <!-- Fléchette 2 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/tir_deux"
                    android:layout_width="58dp" android:layout_height="58dp"
                    android:text="·" android:textSize="26sp" android:textStyle="bold"
                    android:gravity="center" android:fontFamily="@font/led"
                    android:textColor="#444444"/>
                <ImageView android:id="@+id/ind_deux"
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:visibility="invisible"/>
            </LinearLayout>

            <!-- Fléchette 3 -->
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/tir_trois"
                    android:layout_width="58dp" android:layout_height="58dp"
                    android:text="·" android:textSize="26sp" android:textStyle="bold"
                    android:gravity="center" android:fontFamily="@font/led"
                    android:textColor="#444444"/>
                <ImageView android:id="@+id/ind_trois"
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:visibility="invisible"/>
            </LinearLayout>

            <!-- Légende indicateurs -->
            <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
                android:orientation="vertical" android:gravity="center" android:paddingEnd="8dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">
                    <View android:layout_width="14dp" android:layout_height="14dp"
                        android:background="#FF00E676" android:layout_marginEnd="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Bonne pos." android:textColor="#CCCCCC" android:textSize="10sp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <View android:layout_width="14dp" android:layout_height="14dp"
                        android:background="#FFFF9800" android:layout_marginEnd="4dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Bon chiffre" android:textColor="#CCCCCC" android:textSize="10sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- HISTORIQUE (sans bandeau en-tête) -->
        <ListView
            android:id="@+id/listHistorique"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="4dp"
            android:divider="#22FFFFFF"
            android:dividerHeight="1dp"/>

    </LinearLayout>

</RelativeLayout>
