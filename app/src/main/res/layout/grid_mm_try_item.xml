<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- Tour numéro -->
    <TextView
        android:id="@+id/try_tour"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:text="1"
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:fontFamily="@font/led"
        android:gravity="center"/>

    <!-- Nom du joueur -->
    <TextView
        android:id="@+id/try_joueur"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:text="Joueur"
        android:textColor="#DDDDDD"
        android:textSize="13sp"
        android:fontFamily="@font/bines"
        android:gravity="center"
        android:ellipsize="end"
        android:maxLines="1"/>

    <!-- Fléchette 1 : valeur + indicateur -->
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/try_f1"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="-" android:textColor="#CCCCCC" android:textSize="13sp"
            android:fontFamily="@font/led"/>
        <View android:id="@+id/try_ind1"
            android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginStart="3dp" android:background="#00000000"/>
    </LinearLayout>

    <!-- Fléchette 2 -->
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/try_f2"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="-" android:textColor="#CCCCCC" android:textSize="13sp"
            android:fontFamily="@font/led"/>
        <View android:id="@+id/try_ind2"
            android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginStart="3dp" android:background="#00000000"/>
    </LinearLayout>

    <!-- Fléchette 3 -->
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/try_f3"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="-" android:textColor="#CCCCCC" android:textSize="13sp"
            android:fontFamily="@font/led"/>
        <View android:id="@+id/try_ind3"
            android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginStart="3dp" android:background="#00000000"/>
    </LinearLayout>

</LinearLayout>
